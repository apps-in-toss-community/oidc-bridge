# `oidc-bridge.aitc.dev` is the community public instance hostname.
# Self-hosters: change it to the domain whose A record points at your host.
# Caddy obtains and renews a Let's Encrypt certificate automatically on the
# first request — no manual cert management required. The ACME account email
# is read from the ACME_EMAIL env var (set in .env).
#
# `app:8080` resolves over the compose-internal `bridge` network.
{
	email {$ACME_EMAIL}
}

oidc-bridge.aitc.dev {
	encode gzip zstd

	# Caddy automatically forwards X-Forwarded-{For,Proto,Host} to the
	# upstream. We add X-Real-IP so the bridge's per-IP rate limiter
	# can pick up the original client address without parsing XFF.
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}

	# Liveness probe — useful for external uptime monitors.
	handle /healthz {
		reverse_proxy app:8080
	}
}
