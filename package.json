{
  "name": "@ait-co/oidc-bridge",
  "version": "0.0.0",
  "description": "OIDC adapter that bridges Toss login into BaaS platforms (Supabase, Firebase, Auth0, Keycloak) — community-run with a public rate-limited instance, plus a self-host Docker image",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "oidc-bridge": "./dist/index.mjs"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:cli",
    "build:server": "tsdown src/server.ts --format esm",
    "build:cli": "tsdown cli/index.ts --format esm --no-clean",
    "start": "node dist/server.mjs",
    "dev": "tsdown src/server.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:toss": "tsx scripts/live-toss-spike.ts",
    "test:e2e:live": "TOSS_LIVE_TEST=1 vitest run --project live",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:d1": "drizzle-kit generate --config=drizzle.config.d1.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.config.pg.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config=drizzle.config.sqlite.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "undici": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "^4.20260510.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260507.1",
    "pino-pretty": "^11.3.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/sdk-node": "^0.217.0"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "oidc",
    "firebase",
    "auth",
    "bridge"
  ],
  "packageManager": "pnpm@10.33.0",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/apps-in-toss-community/oidc-bridge"
  },
  "bugs": {
    "url": "https://github.com/apps-in-toss-community/oidc-bridge/issues"
  }
}
