{
  "name": "@ait-co/oidc-bridge",
  "version": "0.0.0",
  "description": "OIDC + Firebase Custom Token bridge for Toss login — community-run with public rate-limited instance, plus self-host Docker image",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "oidc-bridge": "./dist/index.mjs"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:cli",
    "build:server": "tsdown src/server.ts --format esm",
    "build:cli": "tsdown cli/index.ts --format esm --no-clean",
    "start": "node dist/server.mjs",
    "dev": "tsdown src/server.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:toss": "tsx scripts/live-toss-spike.ts",
    "test:e2e:live": "TOSS_LIVE_TEST=1 vitest run --project live",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.config.pg.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config=drizzle.config.sqlite.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.12",
    "jose": "^5.10.0",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "undici": "^8.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.30.6",
    "pino-pretty": "^11.3.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "oidc",
    "firebase",
    "auth",
    "bridge"
  ],
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/apps-in-toss-community/oidc-bridge"
  },
  "bugs": {
    "url": "https://github.com/apps-in-toss-community/oidc-bridge/issues"
  }
}
