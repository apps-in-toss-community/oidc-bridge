{
  "name": "@ait-co/oidc-bridge",
  "version": "0.0.0",
  "description": "OIDC + Firebase Custom Token bridge for Toss login — community-run with public rate-limited instance, plus self-host Docker image",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "oidc-bridge": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "commander": "^12.1.0",
    "hono": "^4.6.12",
    "jose": "^5.10.0",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "oidc",
    "firebase",
    "auth",
    "bridge"
  ],
  "packageManager": "pnpm@10.33.0",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/apps-in-toss-community/oidc-bridge"
  },
  "bugs": {
    "url": "https://github.com/apps-in-toss-community/oidc-bridge/issues"
  },
  "optionalDependencies": {
    "@google-cloud/secret-manager": "^5.6.0"
  }
}
